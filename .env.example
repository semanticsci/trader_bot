# Copy this file to `.env` and fill it in. `.env` is git-ignored — never commit real keys.

# ---- Broker (Alpaca) -------------------------------------------------------
# Get keys at https://app.alpaca.markets  ->  Paper Trading  ->  API Keys.
# Paper keys ONLY move fake money. Start here. Always.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper account (fake money). false = live account (real money).
ALPACA_PAPER=true

# ---- Safety interlock ------------------------------------------------------
# To trade real money you must set BOTH ALPACA_PAPER=false AND this exact phrase.
# This is deliberate friction. Leave it blank while learning.
TRADER_LIVE_CONFIRM=

# ---- Telegram (approval channel) ------------------------------------------
# 1. Message @BotFather on Telegram, /newbot, copy the token.
# 2. Message your new bot once (say "hi"), then run `trader telegram-test`
#    to discover your chat id, and paste it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Brain (Anthropic) -----------------------------------------------------
# Only needed if the pipeline calls Claude itself (`trader propose`).
# If a Claude Code / Cowork scheduled task acts as the brain instead
# (`trader propose --decision file.json`), you can leave this blank.
ANTHROPIC_API_KEY=
# Model used for the decision step.
TRADER_MODEL=claude-opus-5

# ---- Storage ---------------------------------------------------------------
TRADER_DB_PATH=data/journal.db
